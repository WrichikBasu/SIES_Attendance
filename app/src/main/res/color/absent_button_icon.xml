<?xml version="1.0" encoding="utf-8"?>
<!--
  The cross stays legible against both states: onErrorContainer on the filled red, plain error
  red on the empty outline.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="?attr/colorOnErrorContainer" android:state_checked="true" />
    <item android:color="?attr/colorError" />
</selector>
