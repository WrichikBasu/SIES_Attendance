<?xml version="1.0" encoding="utf-8"?>
<!--
  One RecyclerView for the screen. The controls live in view_stats_header as its first item
  (see AdapterHeader), so the page scrolls as a whole without giving up row recycling — which
  matters here because grouping by Lecture can return thousands of rows.
-->
<androidx.recyclerview.widget.RecyclerView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rvStats"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:focusableInTouchMode="true"
    android:paddingBottom="24dp"
    tools:itemCount="6"
    tools:listitem="@layout/item_stat_row" />
