<?xml version="1.0" encoding="utf-8"?>
<!--
  A course as it appears in the picker. The department, stream and year are shown because the
  code alone does not say which cohort a course belongs to, and the whole point of the picker
  is choosing across departments and streams.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingVertical="4dp">

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/cbCourse"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="false"
        android:focusable="false" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvCourseTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            tools:text="CS301 – Data Structures" />

        <TextView
            android:id="@+id/tvCourseMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="Computer Science · BSc · SY · Major" />

    </LinearLayout>

</LinearLayout>
