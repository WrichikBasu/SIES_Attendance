<?xml version="1.0" encoding="utf-8"?>
<!--
  The fields and filters live in view_edit_batch_header as the list's first item, so the page
  scrolls in one piece. The save button stays pinned: it is the point of the screen and should
  not require scrolling past every student to reach.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusableInTouchMode="true"
    android:orientation="vertical">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvStudents"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        tools:itemCount="8"
        tools:listitem="@layout/item_student_selectable" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSaveBatch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:enabled="false"
        android:text="@string/action_save_changes" />

</LinearLayout>
