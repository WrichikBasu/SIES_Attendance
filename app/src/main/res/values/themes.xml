<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
      NoActionBar: the app bar is a MaterialToolbar declared in activity_home so it sits in the
      layout flow rather than floating over the content. ActivityHome registers it with
      setSupportActionBar, so NavigationUI still drives the title and up arrow.
    -->
    <style name="Base.Theme.SIESAttendance" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowLightStatusBar">?attr/isLightTheme</item>
    </style>

    <style name="Theme.SIESAttendance" parent="Base.Theme.SIESAttendance" />

</resources>
