    <!--
        Where the server is, and the one thing that has to be set for a
        build to sync.

        EMPTY ON PURPOSE. This build has no server, so the app works
        entirely on its own: SyncClient.isConfigured() is false, nothing
        is scheduled, and no screen offers to sign in to anything. That
        is what every install does today and what a release does until
        somebody sets an address here.

        It also disarms the placeholder pins in
        network_security_config.xml, which would otherwise refuse every
        connection. Setting this without setting those means the first
        request fails loudly, which is the right order for those two
        things to be done in.

        https only: that file refuses cleartext, and the pins in it are
        for the host named here. A debug build overrides this with a
        local http address; see src/debug/res.
    -->
    <string name="sync_base_url" translatable="false"></string>

