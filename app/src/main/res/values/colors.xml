<?xml version="1.0" encoding="utf-8"?>
<!--
  The names match the roles Material 3 defines, so a palette generated by the Material Theme
  Builder (m3.material.io/theme-builder) can be pasted straight in.
-->
<resources>

    <!-- Primary: main brand colour, used for the FAB, filled buttons and selected states -->
    <color name="md_primary">#2196F3</color>
    <color name="md_on_primary">#FFFFFF</color>
    <color name="md_primary_container">#D1E4FF</color>
    <color name="md_on_primary_container">#001D36</color>
    <color name="md_inverse_primary">#8AC7FF</color>

    <!-- Secondary: supporting accents, tonal buttons, chips -->
    <color name="md_secondary">#00A896</color>
    <color name="md_on_secondary">#FFFFFF</color>
    <color name="md_secondary_container">#B8F5EA</color>
    <color name="md_on_secondary_container">#00201C</color>

    <!-- Tertiary: contrast accent, used here for professor avatars -->
    <color name="md_tertiary">#6FAE2A</color>
    <color name="md_on_tertiary">#FFFFFF</color>
    <color name="md_tertiary_container">#D7F5A8</color>
    <color name="md_on_tertiary_container">#172100</color>

    <!-- Error -->
    <color name="md_error">#BA1A1A</color>
    <color name="md_on_error">#FFFFFF</color>
    <color name="md_error_container">#FFDAD6</color>
    <color name="md_on_error_container">#410002</color>

    <!-- Surfaces and background -->
    <color name="md_background">#F5FBFF</color>
    <color name="md_on_background">#171C20</color>
    <color name="md_surface">#F5FBFF</color>
    <color name="md_on_surface">#171C20</color>
    <color name="md_surface_variant">#DFEAF3</color>
    <color name="md_on_surface_variant">#41474D</color>
    <color name="md_inverse_surface">#2C3135</color>
    <color name="md_inverse_on_surface">#ECF2F7</color>

    <!-- Surface container tones, used for card and sheet elevation -->
    <color name="md_surface_container_lowest">#FFFFFF</color>
    <color name="md_surface_container_low">#EFF7FC</color>
    <color name="md_surface_container">#E8F2F8</color>
    <color name="md_surface_container_high">#E0ECF4</color>
    <color name="md_surface_container_highest">#D9E6EE</color>

    <!-- Outlines -->
    <color name="md_outline">#71787E</color>
    <color name="md_outline_variant">#C1C8CF</color>

    <color name="md_scrim">#000000</color>

    <!--
      App-specific semantic colours. These are not Material roles, so they are named for what
      they mean rather than where they sit in the palette.
    -->
    <color name="attendance_ok">#16A765</color>
    <color name="attendance_short">#E53935</color>

</resources>
