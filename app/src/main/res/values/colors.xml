<?xml version="1.0" encoding="utf-8"?>
<!--
  The entire light colour scheme lives here. Every Material 3 role is a named colour, and
  themes.xml does nothing but map each theme attribute onto one of these names.

  To re-theme the app, change the hex values in this file and in values-night/colors.xml.
  Nothing else needs editing: no layout or Java file hardcodes a colour, they all go through
  the ?attr/... indirection.

  The names match the roles Material 3 defines, so a palette generated by the Material Theme
  Builder (m3.material.io/theme-builder) can be pasted straight in.
-->
<resources>

    <!-- Primary: main brand colour, used for the FAB, filled buttons and selected states -->
    <color name="md_primary">#38608F</color>
    <color name="md_on_primary">#FFFFFF</color>
    <color name="md_primary_container">#D2E4FF</color>
    <color name="md_on_primary_container">#001D36</color>
    <color name="md_inverse_primary">#A2C9FE</color>

    <!-- Secondary: supporting accents, tonal buttons, chips -->
    <color name="md_secondary">#535F70</color>
    <color name="md_on_secondary">#FFFFFF</color>
    <color name="md_secondary_container">#D7E3F8</color>
    <color name="md_on_secondary_container">#101C2B</color>

    <!-- Tertiary: contrast accent, used here for professor avatars -->
    <color name="md_tertiary">#6B5778</color>
    <color name="md_on_tertiary">#FFFFFF</color>
    <color name="md_tertiary_container">#F3DAFF</color>
    <color name="md_on_tertiary_container">#251431</color>

    <!-- Error -->
    <color name="md_error">#BA1A1A</color>
    <color name="md_on_error">#FFFFFF</color>
    <color name="md_error_container">#FFDAD6</color>
    <color name="md_on_error_container">#410002</color>

    <!-- Surfaces and background -->
    <color name="md_background">#F8F9FF</color>
    <color name="md_on_background">#191C20</color>
    <color name="md_surface">#F8F9FF</color>
    <color name="md_on_surface">#191C20</color>
    <color name="md_surface_variant">#DFE2EB</color>
    <color name="md_on_surface_variant">#43474E</color>
    <color name="md_inverse_surface">#2E3135</color>
    <color name="md_inverse_on_surface">#EFF0F7</color>

    <!-- Surface container tones, used for card and sheet elevation -->
    <color name="md_surface_container_lowest">#FFFFFF</color>
    <color name="md_surface_container_low">#F2F3FA</color>
    <color name="md_surface_container">#ECEEF4</color>
    <color name="md_surface_container_high">#E7E8EE</color>
    <color name="md_surface_container_highest">#E1E2E9</color>

    <!-- Outlines -->
    <color name="md_outline">#73777F</color>
    <color name="md_outline_variant">#C3C6CF</color>

    <color name="md_scrim">#000000</color>

    <!--
      App-specific semantic colours. These are not Material roles, so they are named for what
      they mean rather than where they sit in the palette.
    -->
    <color name="attendance_ok">#1B6B45</color>
    <color name="attendance_short">#BA1A1A</color>

</resources>
