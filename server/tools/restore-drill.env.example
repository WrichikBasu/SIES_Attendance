# Settings for tools/restore-drill.sh, on the machine that holds the off-machine copy.
# Copy to ~/.config/sies-attendance/restore-drill.env and lock it down:
#
#   install -D -m 600 server/tools/restore-drill.env.example ~/.config/sies-attendance/restore-drill.env
#
# Absolute paths only: this file is read by bash, from cron, and ~ is not expanded here.

# The copy of /var/lib/sies-attendance-backups/: the dumps, base/ and wal/.
BACKUP_DIR=/home/you/sies-backups

# The private key. Required. An unattended drill needs it on this machine, readable by you
# alone (chmod 600), and NOT inside BACKUP_DIR: anyone who takes the backups and the key
# together can read every record. The drill refuses a key inside BACKUP_DIR.
IDENTITY=/home/you/sies-backup-key.txt

# The jar to restore with. Empty: build it from this checkout with ./gradlew :server:bootJar,
# as the README does. Set it to a copy of the jar in /opt/sies-attendance/ on the server to
# drill exactly what production runs.
JAR=

# Java 25, if `java` on cron's PATH is something else.
JAVA=/usr/bin/java

# The three role passwords, from the password manager. Optional, each on its own. A password
# that is set is used for both restores, and is checked against the password point-in-time
# recovery brings back: if production's is different, the drill fails, because the password
# manager is out of date. A password left empty is replaced with a throwaway one.
DB_OWNER_PASSWORD=
DB_APP_PASSWORD=
DB_AUDITOR_PASSWORD=

# How stale the copy may be before the drill fails. The dump and base backup are nightly;
# WAL arrives at least every 5 minutes and the copy runs every 5, so 30 minutes means
# something has stopped.
MAX_DUMP_AGE_HOURS=26
MAX_BASE_AGE_HOURS=26
MAX_WAL_AGE_MINUTES=30

# Each restore, from container start to a service answering, must take no longer than this.
MAX_RESTORE_MINUTES=30

# yes: a notification on success too, not only on failure.
NOTIFY_ON_SUCCESS=no

# Where each run's full log goes, and how many to keep.
# LOG_DIR=/home/you/.local/state/sies-restore-drill
KEEP_LOGS=60
