# Copy to /etc/sies-attendance/env, fill in, and lock down:
#
#   install -D -m 600 -o root -g root sies-attendance.env.example /etc/sies-attendance/env
#
# The service refuses to start without these rather than connecting to something by
# accident -- there is no development default for a database password anywhere in this
# repository, on purpose. An unset variable used to reach PostgreSQL as the literal text
# ${DB_APP_PASSWORD} and come back as "password authentication failed", which reads like a
# wrong password and is not one; SiesAttendanceServer.missingCredentials now says which
# variable is missing before Spring builds a bean.

# Where the database is. 5432 in production; the development default is 55432 so that a
# throwaway container cannot collide with a real PostgreSQL on the same machine.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sies

# What the service connects as. NOT the owner: this role cannot run DDL and cannot UPDATE
# or DELETE an audit row. See "Three database roles" in the README.
DB_APP_USER=sies_app
DB_APP_PASSWORD=

# The owner's password belongs on the machine that runs the migrations, not in the
# service's environment file. Keep it somewhere a person reaches deliberately:
#
#   DB_OWNER_PASSWORD=... java -jar sies-attendance.jar --spring.profiles.active=migrate
#
# If you do put it here, the migrate step can read this file -- but then so can the
# service, and the point of three roles is that the long-running process cannot run DDL.
# DB_OWNER_PASSWORD=

# The public port. Behind a proxy there is no reason for it to be 80 or 443.
SERVER_PORT=8080

# How many sign-in attempts one address gets every five minutes. Counted in memory, per
# process: see LoginRateLimiter before running a second instance, because two instances
# mean twice this number.
LOGIN_ATTEMPTS=10

# INFO logs every statement the service runs, which is how a filter-assembled query is
# diagnosed. Values are bound and never logged, but the statements are noisy and name the
# schema; WARN in production, INFO while diagnosing.
SQL_LOG_LEVEL=WARN
